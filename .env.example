# Telegram bot token from BotFather
BOT_TOKEN=

# Required for Render webhook mode: 1-256 chars, A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# Optional; defaults to the current Render service URL
RENDER_EXTERNAL_URL=https://nawaf-bot-v2.onrender.com

# Supabase PostgreSQL connection string
# Prefer Supabase Transaction Pooler when deploying on Render.
DATABASE_URL=

# Optional pool tuning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# AI assistant (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Secondary Telegram account for voice calls and profile clock
API_ID=
API_HASH=
SESSION_STRING=