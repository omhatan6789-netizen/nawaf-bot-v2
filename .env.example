# Telegram bot token from BotFather
BOT_TOKEN=

# Supabase PostgreSQL connection string
# Prefer Supabase Transaction Pooler when deploying on Render.
DATABASE_URL=

# Optional pool tuning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# AI assistant (optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Secondary Telegram account for voice calls and profile clock
API_ID=
API_HASH=
SESSION_STRING=